# Copy this file to ".env" in this SAME folder (repo root) before running
# `docker compose up`. This is a different, separate .env from
# skin_backend/.env - that one is only for local `manage.py runserver`
# dev outside Docker; this root one is what docker-compose.yml reads to
# fill in the containers' environment variables.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-string

# Optional - without it, condition scans still work, but the AI care
# recommendations / chat Q&A fall back to the built-in fallback text
# instead of calling Gemini. Get one at https://aistudio.google.com/
GEMINI_API_KEY=

POSTGRES_DB=skinscan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-too
